# Database (PostgreSQL)
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Local development URL.
# In production set to your public domain, e.g. https://codegolf.ru
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
ALLOW_DEV_LOGIN="false"
TRUST_PROXY="false"
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""
DISABLE_STRICT_ENV="false"
# Temporary transition flag only (do not keep true permanently in production)
ALLOW_SQLITE_IN_PRODUCTION="false"

# Stepik OAuth
STEPIK_CLIENT_ID=""
STEPIK_CLIENT_SECRET=""
# Local callback URL.
# In production set to https://<your-domain>/api/auth/stepik/callback
STEPIK_REDIRECT_URI="http://localhost:3000/api/auth/stepik/callback"
# Optional separate local OAuth app (recommended if production app allows only one redirect URI)
STEPIK_CLIENT_ID_LOCAL=""
STEPIK_CLIENT_SECRET_LOCAL=""
STEPIK_REDIRECT_URI_LOCAL="http://localhost:3000/api/auth/stepik/callback"

# Раннер кода Piston — контейнер из docker-compose.yml на этом же сервере.
# В боевом режиме обязателен: без него сайт не стартует (src/lib/env.ts).
# Не указывайте публичный emkc.org — он платный, и код участников уйдёт третьей стороне
PISTON_API_URL="http://127.0.0.1:2000/api/v2"

# Языки кроме Python (docs/three-languages.md). true — у задач с сигнатурой
# с типами появляется переключатель языка. Нужны пакеты в раннере: npm run dev:piston
# (Node.js для JavaScript, mono для C#). После правки: sudo systemctl restart codegolf
JAVASCRIPT_ENABLED="false"
CSHARP_ENABLED="false"
# Сколько C#-решений собирается одновременно. На сервере 2 ядра / 4 ГБ раннеру
# отдано целое ядро — две сборки параллельно. На одном ядре ставьте 1
CSHARP_MAX_CONCURRENT="2"

# Пароль базы для docker-compose.yml — тот же, что в DATABASE_URL
POSTGRES_PASSWORD="codegolf"

# Admin seed (used by prisma db seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
