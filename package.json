{
  "name": "codegolf-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:migrate:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init --schema prisma/schema.prisma",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:topics:backfill": "npx tsx scripts/backfill-task-topics.ts",
    "db:tasks:import": "npx tsx scripts/import-codegolf-tasks.ts",
    "db:tasks:import-export": "npx tsx scripts/import-tasks-from-export.ts",
    "db:tasks:cleanup": "npx tsx scripts/cleanup-duplicate-tasks.ts",
    "db:tasks:csharp": "npx tsx scripts/sync-csharp-signatures.ts",
    "db:progress:backfill": "npx tsx scripts/backfill-progress-stats.ts",
    "db:competitions:backfill": "npx tsx scripts/backfill-competition-entries.ts",
    "ops:preflight:postgres": "npx tsx scripts/preflight-postgres.ts",
    "ops:smoke": "npx tsx scripts/smoke-check.ts",
    "check:rules": "npx tsx scripts/check-product-rules.ts",
    "ops:predeploy": "bash scripts/predeploy-check.sh",
    "ops:backup": "bash scripts/backup-db.sh",
    "ops:backup:verify": "bash scripts/verify-backup.sh",
    "ops:restore": "bash scripts/restore-db.sh",
    "ops:env:check": "bash scripts/check-env.sh",
    "test:sandbox": "npx tsx scripts/verify-sandbox.ts",
    "test:sandbox:csharp": "npx tsx scripts/verify-sandbox-csharp.ts",
    "test:sandbox:js": "npx tsx scripts/verify-sandbox-js.ts",
    "dev:up": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:piston": "node scripts/install-piston-runtimes.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "acorn": "^8.18.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.344.0",
    "next": "^15.5.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
